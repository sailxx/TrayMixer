<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TrayMixer</AssemblyName>
    <Version>3.1.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <Compile Remove="tests/**/*.cs" />
    <AvaloniaResource Include="../TrayMixer.ico" Link="Assets/TrayMixer.ico" />
  </ItemGroup>
</Project>
