<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>TrayMixer.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- exclude tools and installer subdirectories, and temp files -->
    <Compile Remove="installer\**" />
    <Compile Remove="tools\**" />
    <Compile Remove="temp_*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.*" />
  </ItemGroup>
</Project>
